# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Claude Code agent worktrees (ephemeral, machine-specific).
.claude/worktrees/

# Lattice local-first runtime artifacts — never commit these (machine-specific, ephemeral).
# The schema (.lattice/schema.json) IS meant to be checked in.
.lattice/cache/
.lattice/toolchains/
.lattice/bin/
.lattice-setup-marker

apps/web/node_modules/

# Astro build output and generated content types for the site.
apps/web/dist/
apps/web/.astro/

# Nested-repo example: the inner runner's dependency tree, its own cache, and
# everything either runner builds.
examples/nested-repo/frontend/node_modules/
examples/nested-repo/**/.turbo/
examples/nested-repo/**/dist/

# Running the examples (README/CONTRIBUTING tell contributors to) leaves the same
# ephemeral runtime artifacts there as at the repo root.
examples/**/.lattice/cache/
examples/**/.lattice/toolchains/
examples/**/.lattice/bin/