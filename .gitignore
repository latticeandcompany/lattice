# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Editors and OS
.idea/
.vscode/
.DS_Store
*.log

# Claude Code agent worktrees (ephemeral, machine-specific).
.claude/worktrees/

# Lattice local-first runtime artifacts — never commit these (machine-specific, ephemeral).
# The schema (.lattice/schema.json) IS meant to be checked in.
.lattice/cache/
.lattice/toolchains/
.lattice/bin/
.lattice-setup-marker

node_modules/

# Astro build output and generated content types. Not scoped to apps/web: running
# the site from the repo root drops a .astro/ here instead.
dist/
.astro/

# Running the examples (README/CONTRIBUTING tell contributors to) leaves the same
# ephemeral runtime artifacts there as at the repo root, plus whatever each
# example's own toolchain builds.
examples/**/.lattice/cache/
examples/**/.lattice/toolchains/
examples/**/.lattice/bin/
.turbo/
examples/**/.turbo/
examples/**/.venv/
examples/**/bin/
examples/**/__pycache__/