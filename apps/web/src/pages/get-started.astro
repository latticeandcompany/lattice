---
import Layout from '../layouts/Layout.astro';
import CopyCommand from '../components/copyCommand';
import { githubUrl, installCommand } from '../lib/nav';
import { withBase } from '../lib/base';

// Every terminal transcript on this page was captured from lattice 1.0.0-beta-2
// running against a two-package repo. Re-capture them rather than editing by hand.
const initOutput = `✓ wrote lattice.json
✓ wrote .lattice/schema.json
✓ updated .gitignore

next: lattice run build`;

const config = `{
  "$schema": ".lattice/schema.json",
  "latticeVersion": "1.0.0-beta-2",
  "workspaces": [
    { "name": "ui",  "path": "packages/ui" },
    { "name": "web", "path": "apps/web", "dependsOn": ["ui"] }
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*"],
      "outputs": ["dist/**"]
    }
  }
}`;

const setupOutput = `❖ lattice  setup
● ui npm install
● web npm install
❖ setup complete`;

const coldRun = `lattice: running \`build\` across 2 workspace(s)
lattice: ui:build: hash 664f4cd394564ff5
lattice: ui:build: cache miss
ui:build: running
ui:build: done (0.21s)
lattice: web:build: hash d97c6e8a847a1e0f
lattice: web:build: cache miss
web:build: running
web:build: done (0.18s)
lattice: 2 tasks, 0 cached, 0 failed, 0.39s`;

const warmRun = `lattice: running \`build\` across 2 workspace(s)
lattice: ui:build: hash 664f4cd394564ff5
ui:build: cache hit [664f4cd3]
lattice: web:build: hash d97c6e8a847a1e0f
web:build: cache hit [d97c6e8a]
lattice: 2 tasks, 2 cached, 0 failed, 0.00s`;

const next = [
	{
		name: 'Installation',
		href: withBase('/docs/installation'),
		blurb: 'Supported platforms, building from source, shell completions, and how to remove it.',
	},
	{
		name: 'Workspaces',
		href: withBase('/docs/workspaces'),
		blurb: 'What a workspace is, how paths and dependencies are declared, and how tasks resolve inside one.',
	},
	{
		name: 'Caching',
		href: withBase('/docs/caching'),
		blurb: 'What goes into a task hash, and what makes a cached result valid to restore.',
	},
	{
		name: 'Toolchains',
		href: withBase('/docs/toolchains'),
		blurb: 'Pin the version of node, rust, go, or any other tool your repo builds against.',
	},
];
---

<Layout
	title="Get started · Lattice"
	description="Install Lattice in a repo, scaffold a config, and run your first cached task."
>
	<section class="px-3 pt-5 pb-4">
		<div class="mx-auto" style="max-width: 48rem;">
			<h1 class="fw-bold mb-3" style="font-size: clamp(2.5rem, 6vw, 3.75rem); letter-spacing: -0.03em;">
				Get started
			</h1>
			<p class="fs-5 mb-0" style="color: var(--text-muted);">
				Six steps from a repo with no Lattice in it to a build that comes back from cache the second
				time you run it. You need a POSIX shell and the tools your projects already use.
			</p>
		</div>
	</section>

	<section class="px-3 pb-5">
		<ol class="steps mx-auto list-unstyled mb-0" style="max-width: 48rem;">
			<li class="step">
				<span class="step__num" aria-hidden="true">1</span>
				<div class="step__body">
					<h2 class="step__title">Install it into your repo</h2>
					<p>From the root of the repo you want to use Lattice in:</p>
					<CopyCommand client:visible command={installCommand} />
					<p class="mt-3">
						The script picks the archive for your platform, checks its SHA-256 against the release's
						published checksums, and refuses to install on a mismatch. The binary lands in
						<code>.lattice/bin/</code>, which the script adds to your <code>.gitignore</code>. The one
						thing written outside the repo is a <code>PATH</code> line in your shell config — pass
						<code>--no-modify-path</code> to skip it and call
						<code>./.lattice/bin/lattice</code> directly instead.
					</p>
					<p class="mb-0">
						On Windows, run the script inside WSL2. For a native install, take the
						<code>x86_64-pc-windows-msvc</code> archive from the
						<a href={`${githubUrl}/releases`} target="_blank" rel="noopener noreferrer">releases page</a>
						and put <code>lattice.exe</code> on your <code>PATH</code>.
					</p>
				</div>
			</li>

			<li class="step">
				<span class="step__num" aria-hidden="true">2</span>
				<div class="step__body">
					<h2 class="step__title">Check that it runs</h2>
					<pre class="step__code"><code>lattice --version</code></pre>
					<pre class="step__code step__code--out"><code>lattice 1.0.0-beta-2</code></pre>
					<p class="mb-0">
						If your shell can't find <code>lattice</code>, open a new terminal so the
						<code>PATH</code> line takes effect.
					</p>
				</div>
			</li>

			<li class="step">
				<span class="step__num" aria-hidden="true">3</span>
				<div class="step__body">
					<h2 class="step__title">Scaffold a config</h2>
					<pre class="step__code"><code>lattice init</code></pre>
					<p>
						On a terminal this opens a short wizard: whether you want the task runner, the toolchain
						manager, or both, then your workspaces and the tool versions to pin. Add
						<code>-y</code> to take the defaults and answer nothing.
					</p>
					<pre class="step__code step__code--out"><code>{initOutput}</code></pre>
					<p class="mb-0">
						<code>lattice.json</code> is your config. <code>.lattice/schema.json</code> is committed
						so your editor validates that config as you type. Everything else under
						<code>.lattice/</code> is per-machine and gitignored.
					</p>
				</div>
			</li>

			<li class="step">
				<span class="step__num" aria-hidden="true">4</span>
				<div class="step__body">
					<h2 class="step__title">Declare your projects</h2>
					<p>
						A workspace is one project directory — the unit Lattice runs and caches tasks in. List
						each by literal path, and say which ones depend on which:
					</p>
					<pre class="step__code step__code--file"><code>{config}</code></pre>
					<p class="mb-0">
						Each workspace runs the tool already in its directory, read from that directory's
						lockfile or manifest. <code>^build</code> means "build this workspace's dependencies
						first," <code>inputs</code> is what the cache watches for changes, and
						<code>outputs</code> is what it captures and restores. To spell a command out yourself
						instead, set <code>"auto": false</code> on a workspace and give it a
						<code>scripts</code> map.
					</p>
				</div>
			</li>

			<li class="step">
				<span class="step__num" aria-hidden="true">5</span>
				<div class="step__body">
					<h2 class="step__title">Install dependencies</h2>
					<pre class="step__code"><code>lattice setup</code></pre>
					<pre class="step__code step__code--out"><code>{setupOutput}</code></pre>
					<p class="mb-0">
						<code>setup</code> provisions any tool versions you pinned, then installs each
						workspace's own dependencies. Run it whenever you like — a workspace whose lockfile
						hasn't changed is skipped.
					</p>
				</div>
			</li>

			<li class="step">
				<span class="step__num" aria-hidden="true">6</span>
				<div class="step__body">
					<h2 class="step__title">Run a task</h2>
					<pre class="step__code"><code>lattice run build -l</code></pre>
					<pre class="step__code step__code--out"><code>{coldRun}</code></pre>
					<p>
						<code>ui</code> builds before <code>web</code> because <code>web</code> depends on it.
						Workspaces with no dependency between them run at the same time. <code>-l</code> prints
						this plain log; drop it and you get a live display instead.
					</p>
					<p>Run it again without changing a file:</p>
					<pre class="step__code step__code--out"><code>{warmRun}</code></pre>
					<p class="mb-0">
						Same hashes, so nothing re-ran: <code>dist/</code> came back out of
						<code>.lattice/cache/</code>. Edit a file under <code>src/</code> and that workspace's
						hash changes, so it — and anything downstream of it — builds again. Everything else
						still comes from cache.
					</p>
				</div>
			</li>
		</ol>
	</section>

	<section class="px-3 pb-5">
		<div class="mx-auto" style="max-width: 48rem;">
			<h2 class="fw-bold mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.25rem); letter-spacing: -0.02em;">
				Where to go next
			</h2>
			<div class="row g-3">
				{
					next.map((item) => (
						<div class="col-12 col-sm-6">
							<a href={item.href} class="card h-100 text-decoration-none next-card">
								<div class="card-body p-4">
									<span class="d-flex align-items-center gap-2 fw-bold mb-2" style="color: var(--text);">
										{item.name}
										<i class="bi bi-arrow-right next-card__arrow" aria-hidden="true" />
									</span>
									<span class="d-block mb-0" style="color: var(--text-subtle); line-height: 1.6;">
										{item.blurb}
									</span>
								</div>
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.steps {
		counter-reset: step;
	}
	.step {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		column-gap: 1.25rem;
		padding-bottom: 3rem;
	}
	.step:last-child {
		padding-bottom: 0;
	}
	/* The rail runs through the number and down to the next step, so the sequence
	   reads as one thread rather than six detached blocks. */
	.step__num {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		font-family: 'DM Mono', monospace;
		font-size: 0.95rem;
		color: var(--focus);
	}
	.step:not(:last-child) .step__num::after {
		content: '';
		position: absolute;
		top: 2.5rem;
		bottom: -3rem;
		left: 50%;
		width: 1px;
		background: var(--border-subtle);
	}
	.step__title {
		margin: 0.25rem 0 0.75rem;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.step__body :global(p) {
		color: var(--text-subtle);
		line-height: 1.65;
	}
	.step__body :global(code) {
		font-family: 'DM Mono', monospace;
		font-size: 0.85em;
		color: var(--text);
	}
	.step__code {
		margin: 0 0 0.75rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--border-subtle);
		border-radius: 6px;
		background: var(--surface-2);
		font-family: 'DM Mono', monospace;
		font-size: 0.82rem;
		line-height: 1.7;
		overflow-x: auto;
	}
	.step__code::before {
		content: '$ ';
		color: var(--text-muted);
	}
	.step__code--out::before,
	.step__code--file::before {
		content: none;
	}
	.step__code--out {
		color: var(--text-muted);
	}
	.next-card__arrow {
		font-size: 0.9rem;
		color: var(--text-muted);
		transition: transform 0.15s ease;
	}
	.next-card:hover .next-card__arrow {
		transform: translateX(0.2rem);
		color: var(--focus);
	}
	@media (max-width: 575.98px) {
		.step {
			grid-template-columns: 2rem 1fr;
			column-gap: 0.9rem;
		}
		.step__num {
			width: 2rem;
			height: 2rem;
			font-size: 0.85rem;
		}
		.step:not(:last-child) .step__num::after {
			top: 2rem;
		}
	}
</style>
