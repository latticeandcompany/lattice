---
import Rosette from './rosette';
import { getStartedUrl, githubUrl, licenseUrl, releasesUrl } from '../lib/nav';
import { withBase } from '../lib/base';

const year = new Date().getFullYear();

// Two short columns of destinations someone would actually go looking for. Deep
// docs pages belong in the docs sidebar, not here.
const columns = [
	{
		title: 'Product',
		links: [
			{ name: 'Get started', href: getStartedUrl },
			{ name: 'Why Lattice', href: withBase('/#why') },
			{ name: 'Documentation', href: withBase('/docs') },
			{ name: 'For agents', href: withBase('/for-agents') },
		],
	},
	{
		title: 'Project',
		links: [
			{ name: 'GitHub', href: githubUrl, external: true },
			{ name: 'Releases', href: releasesUrl, external: true },
			{ name: 'Changelog', href: withBase('/docs/changelog') },
			{ name: 'License', href: licenseUrl, external: true },
		],
	},
];
---

<footer class="px-3 pt-5 pb-4" style="border-top: 1px solid var(--border);">
	<div class="mx-auto" style="max-width: 72rem;">
		<div class="row g-4">
			<div class="col-12 col-lg-5">
				<a href={withBase('/')} class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3" style="color: var(--text);">
					<Rosette size="1.75rem" animate={false} />
					<span class="footer-wordmark">lattice <span class="footer-build">build</span></span>
				</a>
				<p class="mb-0" style="color: var(--text-muted); max-width: 22rem;">
					A high-performance, local toolchain for managing monorepos.
				</p>
			</div>

			{
				columns.map((col, i) => (
					<div class:list={['col-6 col-lg-3', i === 0 && 'offset-lg-1']}>
						<h3 class="text-uppercase mb-3" style="font-size: 0.75rem; letter-spacing: 0.08em; color: var(--text-muted);">
							{col.title}
						</h3>
						<ul class="list-unstyled d-flex flex-column gap-2 mb-0">
							{col.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-decoration-none"
										style="color: var(--text-subtle);"
										{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									>
										{link.name}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div
			class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mt-5 pt-4"
			style="border-top: 1px solid var(--border-subtle); color: var(--text-muted); font-size: 0.875rem;"
		>
			<a href={withBase('/')} class="d-inline-flex align-items-center gap-2 text-decoration-none" style="color: var(--text);">
				<Rosette size="1.4rem" animate={false} />
				<span class="latticeco-word">Lattice <span class="latticeco-amp">&amp;</span> Company</span>
			</a>
			<span>© {year} Lattice &amp; Co.</span>
		</div>
	</div>
</footer>

<style>
	.footer-wordmark {
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: var(--wordmark-tracking);
		color: var(--text);
	}
	.footer-build {
		color: var(--focus);
	}
	.latticeco-word {
		font-family: 'DM Serif Text', Georgia, serif;
		font-size: 1.2rem;
		line-height: 1;
		color: var(--text);
	}
	.latticeco-amp {
		color: var(--gray-500);
	}
</style>
