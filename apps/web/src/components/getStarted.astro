---
import PlatformCommand from './platformCommand';
import { getStartedUrl, githubUrl, installCommand, windowsInstallCommand } from '../lib/nav';
---

<section class="px-3 py-5">
	<div class="card mx-auto text-center" style="max-width: 60rem;">
		<div class="card-body px-3 px-md-5 py-5">
			<h2 class="fw-bold mb-3" style="font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.02em;">
				Install and run
			</h2>
			<p class="fs-5 mb-4 mx-auto" style="color: var(--text-muted); max-width: 34rem;">
				Run this in the root of your repo. Then <code>./.lattice/bin/lattice init</code> writes a config,
				and <code>lattice run build</code> builds every workspace in it.
			</p>
			<div class="d-flex justify-content-center mb-4">
				<PlatformCommand client:visible posix={installCommand} windows={windowsInstallCommand} />
			</div>
			<div class="d-flex flex-wrap gap-2 justify-content-center">
				<a href={getStartedUrl} class="btn btn-contrast px-4">Get started</a>
				<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary px-4">
					<i class="bi bi-github me-2" aria-hidden="true"></i>View on GitHub
				</a>
			</div>
		</div>
	</div>
</section>
