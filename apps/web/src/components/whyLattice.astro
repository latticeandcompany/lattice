---
// What the developer gets, in their terms. Every line is a benefit to the person
// running builds, not a description of how the tool works inside.
interface Benefit {
	icon: string;
	title: string;
	body: string;
}

const benefits: Benefit[] = [
	{
		icon: 'bi-lightning-charge',
		title: 'Builds finish sooner',
		body: 'Repeat a build and the parts that didn\'t change come straight from cache. Change one workspace and Lattice re-runs only that workspace and whatever depends on it.',
	},
	{
		icon: 'bi-command',
		title: 'One command for the whole repo',
		body: 'Build and test every workspace with the same command, whatever language each one uses. Lattice orders the runs by dependency and starts the independent ones together.',
	},
	{
		icon: 'bi-play-circle',
		title: 'No build scripts to write',
		body: 'List your workspaces once. Lattice reads the manifest or lockfile already in each directory to work out the command to run.',
	},
	{
		icon: 'bi-box-seam',
		title: 'The same tool versions everywhere',
		body: 'Pin the compilers, linters, and package managers a workspace needs, and Lattice checks or installs them before any task starts. A fresh clone builds the same on your laptop and in CI.',
	},
];
---

<section id="why" class="px-3 py-5">
	<div class="mx-auto" style="max-width: 72rem;">
		<div class="mx-auto text-center mb-5" style="max-width: 40rem;">
			<h2 class="fw-bold mb-3" style="font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.02em;">
				Less setup, faster builds
			</h2>
			<p class="fs-5 mb-0" style="color: var(--text-muted);">
				Lattice works out which tool each workspace already uses, runs your tasks in dependency
				order, and restores cached results instead of running them twice.
			</p>
		</div>

		<div class="row g-4">
			{
				benefits.map((b) => (
					<div class="col-12 col-md-6">
						<div class="card h-100">
							<div class="card-body p-4">
								<i class={`bi ${b.icon} fs-3 d-block mb-3 lattice-accent`} aria-hidden="true" />
								<h3 class="card-title fw-bold mb-2" style="font-size: 1.375rem;">
									{b.title}
								</h3>
								<p class="card-text mb-0" style="color: var(--text-subtle); line-height: 1.6;">
									{b.body}
								</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
