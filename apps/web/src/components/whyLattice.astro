---
// What the developer gets, in their terms. Every line is a benefit to the person
// running builds, not a description of how the tool works inside.
interface Benefit {
	icon: string;
	title: string;
	body: string;
}

const benefits: Benefit[] = [
	{
		icon: 'bi-diagram-3',
		title: 'Your manifests are the config',
		body: 'Workspaces come from pnpm-workspace.yaml, Cargo members and go.work. Build order comes from workspace:* and path dependencies. A new package is picked up the moment its package manager sees it.',
	},
	{
		icon: 'bi-command',
		title: 'One task name, each tool\'s own command',
		body: 'lattice run lint is cargo clippy in a crate, go vet ./... in a module and the lint script in a package. A workspace with no lint sits the run out instead of failing it.',
	},
	{
		icon: 'bi-lightning-charge',
		title: 'Only what changed runs again',
		body: 'A task is keyed on its inputs, its command, its tool versions and the results of what it depends on. Edit one package and it re-runs with its dependents. Everything else is restored from cache.',
	},
	{
		icon: 'bi-box-seam',
		title: 'A wrong tool version stops the run, and says why',
		body: 'Pin node, the JDK or a linter and Lattice checks it before anything starts. When it is wrong you see the version wanted, the one found and where, and the fix. An installCmd installs it into the repo instead.',
	},
];
---

<section id="why" class="px-3 py-5">
	<div class="mx-auto" style="max-width: 72rem;">
		<div class="mx-auto text-center mb-5" style="max-width: 40rem;">
			<h2 class="fw-bold mb-3" style="font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.02em;">
				Point it at the repo you already have
			</h2>
			<p class="fs-5 mb-0" style="color: var(--text-muted);">
				Lattice finds the workspaces, their dependencies and their tasks in the files your tools
				already read, so the config is only what those files cannot say.
			</p>
		</div>

		<div class="row g-4">
			{
				benefits.map((b) => (
					<div class="col-12 col-md-6">
						<div class="card h-100">
							<div class="card-body p-4">
								<i class={`bi ${b.icon} fs-3 d-block mb-3 lattice-accent`} aria-hidden="true" />
								<h3 class="card-title fw-bold mb-2" style="font-size: 1.375rem;">
									{b.title}
								</h3>
								<p class="card-text mb-0" style="color: var(--text-subtle); line-height: 1.6;">
									{b.body}
								</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
