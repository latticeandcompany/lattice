---
// Lattice Desktop on the home page.
//
// Crimson is this product's accent, so it appears on the product word and on the one
// primary action — the same budget teal gets everywhere else, not a licence to tint
// the section. Everything structural stays monochrome.
import Rosette from './rosette.tsx';
import { desktopUrl } from '../lib/nav';
import { withBase } from '../lib/base';

interface Capability {
	icon: string;
	title: string;
	body: string;
}

const capabilities: Capability[] = [
	{
		icon: 'bi-list-task',
		title: 'What every workspace can run',
		body: 'Each workspace with the tasks its manifest and its tool give it, and where each came from. Run one, or several across the repo, and read the output as it prints.',
	},
	{
		icon: 'bi-diagram-3',
		title: 'The graph, filling in',
		body: 'The task graph in dependency order, updating as the run moves through it. Focus a task to light up everything it depends on and everything that depends on it.',
	},
	{
		icon: 'bi-tools',
		title: 'Tool versions and the cache',
		body: 'Which node, JDK or compiler each workspace runs with and where it lives, checked the way a run checks it. How big the cache is, the time it has saved, and a prune button.',
	},
	{
		icon: 'bi-search',
		title: 'Why a task ran again',
		body: 'A task that missed the cache names what moved: its inputs, its command, a tool version, or a task it depends on.',
	},
];
---

<section id="desktop" class="px-3 py-5" style="border-top: 1px solid var(--border-subtle);">
	<div class="mx-auto" style="max-width: 72rem;">
		<div class="mx-auto text-center mb-5" style="max-width: 44rem;">
			<div class="d-inline-flex align-items-center gap-2 mb-3">
				<Rosette client:visible size="2rem" />
				<span class="desktop-wordmark">
					lattice <span class="desktop-wordmark__product">desktop</span>
				</span>
			</div>
			<h2 class="fw-bold mb-3" style="font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.02em;">
				The same runs, with the whole repo on screen
			</h2>
			<p class="fs-5 mb-0" style="color: var(--text-muted);">
				Lattice Desktop runs the tasks the CLI runs, with the same engine and the same cache, and
				shows what a terminal scrolls past: every workspace, the graph, tool versions and what the
				cache holds.
			</p>
		</div>

		<div class="row g-4 mb-5">
			{
				capabilities.map((capability) => (
					<div class="col-12 col-md-6">
						<div class="card h-100">
							<div class="card-body p-4">
								<i class={`bi ${capability.icon} fs-3 d-block mb-3 desktop-accent`} aria-hidden="true" />
								<h3 class="card-title fw-bold mb-2" style="font-size: 1.375rem;">
									{capability.title}
								</h3>
								<p class="card-text mb-0" style="color: var(--text-subtle); line-height: 1.6;">
									{capability.body}
								</p>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="d-flex flex-wrap gap-2 justify-content-center">
			<a class="btn btn-desktop px-4" href={desktopUrl}>
				Download Lattice Desktop
				<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
			</a>
			<a class="btn btn-secondary px-4" href={withBase('/docs/desktop-app')}>Read the guide</a>
		</div>
	</div>
</section>
