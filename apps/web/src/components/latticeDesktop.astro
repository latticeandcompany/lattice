---
// Lattice Desktop on the home page.
//
// Crimson is this product's accent, so it appears on the product word and on the one
// primary action — the same budget teal gets everywhere else, not a licence to tint
// the section. Everything structural stays monochrome.
import Rosette from './rosette.tsx';
import { desktopUrl } from '../lib/nav';
import { withBase } from '../lib/base';

interface Capability {
	icon: string;
	title: string;
	body: string;
}

const capabilities: Capability[] = [
	{
		icon: 'bi-list-task',
		title: 'Every task in one list',
		body: 'Every workspace in the repo, with the tasks it can run. Start a task, watch its output stream in, and see which results came from cache.',
	},
	{
		icon: 'bi-diagram-3',
		title: 'Watch the graph fill in',
		body: 'The task graph is drawn in dependency order and fills in as the build moves through it. Click a task to isolate it with everything it depends on and everything that depends on it.',
	},
	{
		icon: 'bi-braces',
		title: 'Edit the config without editing JSON',
		body: 'Workspaces, tasks, and tool versions as a form. The same parser a run uses checks every edit as you type, and a repo with no lattice.json gets a four-step walkthrough.',
	},
	{
		icon: 'bi-search',
		title: 'Find out why a task re-ran',
		body: 'When a task misses the cache because something changed, the app names what changed. You get the command, the inputs, the toolchain, or a task it depends on, instead of a bare hash.',
	},
];
---

<section id="desktop" class="px-3 py-5" style="border-top: 1px solid var(--border-subtle);">
	<div class="mx-auto" style="max-width: 72rem;">
		<div class="mx-auto text-center mb-5" style="max-width: 44rem;">
			<div class="d-inline-flex align-items-center gap-2 mb-3">
				<Rosette client:visible size="2rem" />
				<span class="desktop-wordmark">
					lattice <span class="desktop-wordmark__product">desktop</span>
				</span>
			</div>
			<h2 class="fw-bold mb-3" style="font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.02em;">
				Run and inspect your repo in a desktop app
			</h2>
			<p class="fs-5 mb-0" style="color: var(--text-muted);">
				Lattice Desktop runs the same tasks the CLI runs. It also draws the task graph, edits
				lattice.json as a form, and tells you why a task ran again.
			</p>
		</div>

		<div class="row g-4 mb-5">
			{
				capabilities.map((capability) => (
					<div class="col-12 col-md-6">
						<div class="card h-100">
							<div class="card-body p-4">
								<i class={`bi ${capability.icon} fs-3 d-block mb-3 desktop-accent`} aria-hidden="true" />
								<h3 class="card-title fw-bold mb-2" style="font-size: 1.375rem;">
									{capability.title}
								</h3>
								<p class="card-text mb-0" style="color: var(--text-subtle); line-height: 1.6;">
									{capability.body}
								</p>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="d-flex flex-wrap gap-2 justify-content-center">
			<a class="btn btn-desktop px-4" href={desktopUrl}>
				Download Lattice Desktop
				<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
			</a>
			<a class="btn btn-secondary px-4" href={withBase('/docs/desktop-app')}>Read the guide</a>
		</div>
	</div>
</section>
