{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Lattice",
	"identifier": "com.latticeandco.lattice",
	"mainBinaryName": "lattice-desktop",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Lattice",
				"width": 1280,
				"height": 820,
				"minWidth": 960,
				"minHeight": 600
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
		},
		"withGlobalTauri": false
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "msi", "nsis", "deb", "rpm", "appimage"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"publisher": "Lattice & Company",
		"homepage": "https://latticeandcompany.github.io/lattice",
		"copyright": "Copyright (c) Ryan Mullin",
		"license": "ISC",
		"licenseFile": "../../../LICENSE",
		"category": "DeveloperTool",
		"shortDescription": "Run and inspect a monorepo's tasks",
		"longDescription": "Lattice Desktop runs the tasks the Lattice CLI runs, draws the task graph as it fills in, edits lattice.json as a form, and names what changed when a task missed the cache.",
		"linux": {
			"deb": {
				"section": "devel"
			},
			"rpm": {
				"release": "1"
			}
		}
	},
	"plugins": {}
}
