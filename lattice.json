{
  "latticeVersion": "0.1.0",
  "workspaces": [
    { "path": "crates/lattice-config" },
    { "path": "crates/lattice-output" },
    { "path": "crates/lattice-workspace", "dependsOn": ["lattice-config"] },
    { "path": "crates/lattice-cache", "dependsOn": ["lattice-config"] },
    { "path": "crates/lattice-dag", "dependsOn": ["lattice-config", "lattice-workspace"] },
    { "path": "crates/lattice-runner", "dependsOn": ["lattice-dag", "lattice-cache", "lattice-output", "lattice-config", "lattice-workspace"] },
    { "path": "crates/lattice", "dependsOn": ["lattice-runner", "lattice-dag", "lattice-cache", "lattice-output", "lattice-config", "lattice-workspace"] }
  ],
  "engines": {
    "rust": ">=1.75.0"
  },
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*", "Cargo.toml"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*", "tests/**/*"]
    },
    "lint": {
      "inputs": ["src/**/*"]
    },
    "check": {
      "inputs": ["src/**/*", "Cargo.toml"]
    },
    "clean": {}
  }
}
