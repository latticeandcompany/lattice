{
  "$schema": ".lattice/schema.json",
  "latticeVersion": "2.0.0",
  "workspaces": ["apps/*", "packages/npm"],
  "engines": {
    "cargo": ">=1.88.0"
  },
  "globalDependencies": ["Cargo.toml", "apps/desktop/src/**"],
  "tasks": {
    "test": { "dependsOn": ["build"] }
  },
  "overrides": {
    "apps/*": { "engines": { "node": ">=26" } },
    "packages/npm": { "engines": { "node": ">=22" } },
    "apps/desktop": {
      "dependsOn": ["lattice-project", "lattice-events"],
      "tasks": {
        "dev": "npm run app",
        "build": "npm run bundle"
      }
    }
  }
}
